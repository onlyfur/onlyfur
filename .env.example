# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/onlyfur_db
POSTGRES_PRISMA_URL=postgresql://username:password@localhost:5432/onlyfur_db
POSTGRES_URL_NON_POOLING=postgresql://username:password@localhost:5432/onlyfur_db
MONGODB_URI=mongodb://localhost:27017/onlyfur
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
NEXTAUTH_SECRET=your-nextauth-secret-32-characters-plus
NEXTAUTH_URL=https://your-domain.vercel.app
SESSION_SECRET=your-session-secret-32-characters-long
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX=100

# Email Service (for email verification and notifications)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_FROM=noreply@onlyfur.com

# Payment Processing
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_public_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PLATFORM_FEE_PERCENTAGE=20
MINIMUM_PAYOUT_AMOUNT=50

# File Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# File Storage (AWS S3 Alternative)
AWS_S3_BUCKET=onlyfur-content
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1

# Upload Limits
MAX_FILE_SIZE=100MB
MAX_VIDEO_SIZE=500MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/webm

# Social Login (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Content Moderation
OPENAI_API_KEY=your_openai_api_key

# Analytics & Monitoring
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your_mixpanel_token
SENTRY_DSN=https://your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn
LOGROCKET_APP_ID=your-logrocket-app-id

# Real-time Features
WS_PORT=3001
WS_ORIGINS=https://your-domain.vercel.app
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=admin@onlyfur.com

# Security & CORS
CORS_ORIGIN=https://your-domain.vercel.app
CORS_CREDENTIALS=true

# Environment
NODE_ENV=production
VERCEL_URL=https://your-domain.vercel.app

# Age Verification
AGE_VERIFICATION_REQUIRED=true
MINIMUM_AGE=18

# Platform Settings
PLATFORM_NAME=OnlyFur
PLATFORM_DOMAIN=onlyfur.com
SUPPORT_EMAIL=support@onlyfur.com
