# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/onlyfur_db
POSTGRES_PRISMA_URL=postgresql://username:password@localhost:5432/onlyfur_db
POSTGRES_URL_NON_POOLING=postgresql://username:password@localhost:5432/onlyfur_db
MONGODB_URI=mongodb://localhost:27017/onlyfur
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
NEXTAUTH_SECRET=your-nextauth-secret-32-characters-plus
NEXTAUTH_URL=https://your-domain.vercel.app
SESSION_SECRET=your-session-secret-32-characters-long
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX=100

# Admin Credentials (Configure these for production admin access)
ADMIN_EMAIL=admin@onlyfur.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=OnlyFur Admin

# Admin Credentials (CHANGE IN PRODUCTION!)
VITE_ADMIN_EMAIL=admin@yourdomain.com
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=your-secure-admin-password
VITE_ADMIN_DISPLAY_NAME=Platform Administrator

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# API Configuration
VITE_API_URL=https://your-domain.vercel.app/api

# Email Service (for email verification and notifications)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_FROM=noreply@onlyfur.com

# Payment Processing
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_public_key

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id

# File Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# Analytics & Monitoring
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
SENTRY_DSN=your_sentry_dsn

# Social Media Integration
TWITTER_API_KEY=your_twitter_api_key
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# Development Settings
NODE_ENV=development
NEXT_PUBLIC_PWA_ENABLED=true
NEXT_PUBLIC_MOBILE_OPTIMIZED=true

# Platform Configuration
PLATFORM_NAME=OnlyFur
SUPPORT_EMAIL=support@yourdomain.com
CORS_ORIGIN=https://your-domain.vercel.app
CORS_CREDENTIALS=true
