// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model with subscription tiers
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  customUrl   String?  @unique
  displayName String
  avatar      String?
  role        UserRole @default(SUBSCRIBER)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Authentication
  authProvider    AuthProvider @default(EMAIL)
  googleId        String?      @unique
  password        String? // For email/password authentication
  isActive        Boolean      @default(true)
  isEmailVerified Boolean      @default(false)

  // V3.8 Enhanced Authentication
  emailVerificationToken String?
  emailVerifiedAt        DateTime?
  passwordResetToken     String?
  passwordResetExpires   DateTime?
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?
  twoFactorSecret        String?
  isTwoFactorEnabled     Boolean   @default(false)
  tempTwoFactorSecret    String?
  stripeCustomerId       String?

  // V3.8 User Preferences & Settings
  categories           String[]
  tags                 String[]
  isPrivate            Boolean  @default(false)
  allowMessages        Boolean  @default(true)
  website              String?
  twitter              String?
  instagram            String?
  subscriberCount      Int      @default(0)
  notificationSettings Json?
  settings             Json?

  // Subscription information
  subscriptionTier       String?
  subscriptionStatus     SubscriptionStatus @default(FREE)
  subscriptionValidUntil DateTime?

  // Creator specific fields
  bio         String?
  coverImage  String?
  socialLinks Json?

  // V2.9 New fields
  lastLoginAt        DateTime?
  loginAttempts      Int       @default(0)
  preferredLanguage  String    @default("en")
  timezone           String    @default("UTC")
  twoFactorEnabled   Boolean   @default(false)
  emailNotifications Boolean   @default(true)
  pushNotifications  Boolean   @default(true)
  marketingEmails    Boolean   @default(false)

  // V3.5 Online Status Tracking
  isOnline              Boolean        @default(false)
  lastActivityAt        DateTime       @default(now())
  lastSeenAt            DateTime?
  onlineStatusUpdatedAt DateTime       @default(now())
  activityStatus        ActivityStatus @default(OFFLINE)
  followersCount        Int            @default(0)
  followingCount        Int            @default(0)
  contentCount          Int            @default(0)

  // Relations
  createdContent     Content[]
  subscriptions      Subscription[]
  sentMessages       Message[]           @relation("SentMessages")
  receivedMessages   Message[]           @relation("ReceivedMessages")
  transactions       Transaction[]
  twoFactorSecrets   TwoFactorSecret[]
  userSessions       UserSession[]
  notifications      Notification[]
  contentReports     ContentReport[]
  userPreferences    UserPreference[]
  auditLogs          AuditLog[]          @relation("UserAuditLogs")
  adminAuditLogs     AuditLog[]          @relation("AdminAuditLogs")
  userAnalytics      UserAnalytics[]
  apiKeys            ApiKey[]
  webhookEndpoints   WebhookEndpoint[]
  // V3.0 New relations
  liveStreams        LiveStream[]
  streamChatMessages StreamChatMessage[]
  streamDonations    StreamDonation[]
  socialPosts        SocialPost[]
  socialComments     SocialComment[]
  socialLikes        SocialLike[]
  socialShares       SocialShare[]
  following          UserFollow[]        @relation("UserFollows")
  followers          UserFollow[]        @relation("UserFollowing")
  mentionsMade       UserMention[]       @relation("UserMentions")
  mentionsReceived   UserMention[]       @relation("UserMentioned")
  pollVotes          PollVote[]
  aiRecommendations  AIRecommendation[]
  userInsights       UserInsight[]

  // V3.1 Enhanced Payment Relations
  paymentMethods       PaymentMethod[]       @relation("UserPaymentMethods")
  paymentIntents       PaymentIntent[]       @relation("UserPaymentIntents")
  paymentSubscriptions PaymentSubscription[] @relation("UserPaymentSubscriptions")
  creatorSubscriptions PaymentSubscription[] @relation("CreatorPaymentSubscriptions")
  payoutSchedules      PayoutSchedule[]      @relation("UserPayoutSchedules")

  // V3.1 Enhanced Search Relations
  searchAnalytics SearchAnalytics[] @relation("UserSearchAnalytics")
  savedSearches   SavedSearch[]     @relation("UserSavedSearches")

  // V3.1 Mobile App Relations
  mobileDevices         MobileDevice[]     @relation("UserMobileDevices")
  mobileSessions        MobileSession[]    @relation("UserMobileSessions")
  userPushNotifications PushNotification[] @relation("UserPushNotifications")

  // V3.2 Stripe Relations
  stripeCustomer             StripeCustomer?      @relation("UserStripeCustomer")
  stripeSubscriptions        StripeSubscription[] @relation("UserStripeSubscriptions")
  creatorStripeSubscriptions StripeSubscription[] @relation("CreatorStripeSubscriptions")
  blobStorage                BlobStorage[]        @relation("UserBlobStorage")

  // V3.8 New Relations
  contentInteractions ContentInteraction[]
  activities          Activity[]
  creatorApplications CreatorApplication[]
  comments            Comment[]

  @@map("users")
}

model PlatformSubscriptionTier {
  id                String        @id @default(cuid())
  name              String
  type              TierType
  level             TierLevel
  price             Float
  currency          String        @default("USD")
  billingPeriod     BillingPeriod @default(MONTHLY)
  description       String
  features          Json
  limitations       Json
  messagingFeatures Json
  contentAccess     Json
  creatorFeatures   Json?
  isPopular         Boolean       @default(false)
  color             String
  badge             String?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  subscriptions Subscription[]

  @@map("platform_subscription_tiers")
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  tierId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  trialStart         DateTime?
  trialEnd           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier         PlatformSubscriptionTier @relation(fields: [tierId], references: [id])
  transactions Transaction[]

  @@map("subscriptions")
}

model Content {
  id                   String        @id @default(cuid())
  creatorId            String
  title                String
  description          String?
  type                 ContentType
  mediaUrl             String?
  mediaUrls            Json
  thumbnailUrl         String?
  isPublic             Boolean       @default(true)
  requiresSubscription Boolean       @default(false)
  privacyLevel         PrivacyLevel  @default(PUBLIC)
  status               ContentStatus @default(PUBLISHED)
  scheduledAt          DateTime?
  tags                 Json
  category             String?
  fileSize             Int?
  fileName             String?
  mimeType             String?
  dimensions           Json?
  duration             Int?
  likesCount           Int           @default(0)
  commentsCount        Int           @default(0)
  viewsCount           Int           @default(0)
  sharesCount          Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // V3.8 Enhanced Content Fields
  mediaMetadata Json?
  allowComments Boolean @default(true)
  allowDownload Boolean @default(false)
  views         Int     @default(0)
  likes         Int     @default(0)
  comments      Int     @default(0)
  tier          String  @default("FREE")
  textContent   String?

  // Relations
  creator   User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  reports   ContentReport[]
  analytics ContentAnalytics[]

  // V3.8 New Relations
  interactions ContentInteraction[]
  commentsList Comment[]

  @@map("content")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  recipientId    String
  content        String
  messageType    MessageType @default(TEXT)
  mediaUrl       String?
  isRead         Boolean     @default(false)
  readAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  sender    User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Transaction {
  id                String            @id @default(cuid())
  userId            String
  subscriptionId    String?
  amount            Float
  currency          String            @default("USD")
  type              TransactionType
  status            TransactionStatus @default(PENDING)
  paymentMethodType PaymentMethodType
  paymentIntentId   String?
  description       String
  fees              Float             @default(0)
  netAmount         Float
  processedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("transactions")
}

// Enums
enum UserRole {
  CREATOR
  SUBSCRIBER
  ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum ActivityStatus {
  ONLINE
  AWAY
  BUSY
  OFFLINE
}

enum TierType {
  SUBSCRIBER
  CREATOR
}

enum TierLevel {
  BASIC
  PRO
  PREMIUM
  VIP
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  CANCELLED
  PAST_DUE
  UNPAID
  TRIALING
  PAUSED
  EXPIRED
}

enum ContentType {
  PHOTO
  VIDEO
  TEXT
  LIVESTREAM
}

enum PrivacyLevel {
  PUBLIC
  SUBSCRIBERS
  PREMIUM
  PRIVATE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
}

enum TransactionType {
  SUBSCRIPTION
  TIP
  ONE_TIME
  REFUND
  PAYOUT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethodType {
  STRIPE
  PAYPAL
}

// V2.9 New Models

model TwoFactorSecret {
  id          String   @id @default(cuid())
  userId      String
  secret      String
  backupCodes Json // Array of backup codes
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("two_factor_secrets")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  refreshToken String?  @unique
  ipAddress    String?
  userAgent    String?
  location     String?
  device       String?
  isActive     Boolean  @default(true)
  lastActivity DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json? // Additional notification data
  isRead    Boolean              @default(false)
  readAt    DateTime?
  priority  NotificationPriority @default(NORMAL)
  expiresAt DateTime?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ContentReport {
  id          String       @id @default(cuid())
  contentId   String
  reporterId  String
  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  resolution  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  content  Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("content_reports")
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String
  category  String
  key       String
  value     String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, key])
  @@map("user_preferences")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  adminId    String?
  action     AuditAction
  resource   String // e.g., "user", "content", "subscription"
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  user  User? @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  admin User? @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model ContentAnalytics {
  id          String   @id @default(cuid())
  contentId   String
  date        DateTime @db.Date
  views       Int      @default(0)
  uniqueViews Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  downloads   Int      @default(0)
  watchTime   Int      @default(0) // in seconds
  bounceRate  Float    @default(0)
  engagement  Float    @default(0)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, date])
  @@map("content_analytics")
}

model UserAnalytics {
  id                   String   @id @default(cuid())
  userId               String
  date                 DateTime @db.Date
  sessionTime          Int      @default(0) // in seconds
  pageViews            Int      @default(0)
  contentViewed        Int      @default(0)
  messagesExchanged    Int      @default(0)
  subscriptionsChanged Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("user_analytics")
}

model SystemSettings {
  id          String   @id @default(cuid())
  category    String
  key         String   @unique
  value       String
  dataType    String   @default("string") // string, number, boolean, json
  description String?
  isPublic    Boolean  @default(false)
  isEditable  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([category, key])
  @@map("system_settings")
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  keyHash     String    @unique
  permissions Json // Array of allowed permissions
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model WebhookEndpoint {
  id            String    @id @default(cuid())
  userId        String
  url           String
  events        Json // Array of events to subscribe to
  secret        String?
  isActive      Boolean   @default(true)
  lastTriggered DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id           String    @id @default(cuid())
  endpointId   String
  eventType    String
  payload      Json
  responseCode Int?
  responseBody String?
  attempts     Int       @default(1)
  succeeded    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  deliveredAt  DateTime?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@map("webhook_deliveries")
}

// V3.0 New Models

model LiveStream {
  id                   String       @id @default(cuid())
  creatorId            String
  title                String
  description          String?
  category             String
  tags                 Json // Array of tags
  isPrivate            Boolean      @default(false)
  requiresSubscription Boolean      @default(false)
  status               StreamStatus @default(SCHEDULED)
  streamKey            String       @unique
  playbackUrl          String?
  thumbnailUrl         String?
  scheduledAt          DateTime?
  startedAt            DateTime?
  endedAt              DateTime?
  duration             Int? // in seconds
  viewerCount          Int          @default(0)
  maxViewers           Int          @default(0)
  settings             Json // Stream settings object
  analytics            Json // Stream analytics object
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  creator      User                @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  chatMessages StreamChatMessage[]
  donations    StreamDonation[]

  @@map("live_streams")
}

model StreamChatMessage {
  id          String   @id @default(cuid())
  streamId    String
  userId      String
  username    String
  message     String
  timestamp   DateTime @default(now())
  isDeleted   Boolean  @default(false)
  isModerator Boolean  @default(false)
  isCreator   Boolean  @default(false)
  metadata    Json?

  stream LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stream_chat_messages")
}

model StreamDonation {
  id          String   @id @default(cuid())
  streamId    String
  userId      String
  username    String
  amount      Float
  currency    String   @default("USD")
  message     String?
  timestamp   DateTime @default(now())
  isAnonymous Boolean  @default(false)

  stream LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stream_donations")
}

model SocialPost {
  id         String         @id @default(cuid())
  userId     String
  content    String
  mediaUrls  Json? // Array of media URLs
  type       PostType       @default(TEXT)
  visibility PostVisibility @default(PUBLIC)
  isNSFW     Boolean        @default(false)
  tags       Json? // Array of hashtags
  mentions   Json? // Array of mentioned usernames
  likes      Int            @default(0)
  comments   Int            @default(0)
  shares     Int            @default(0)
  views      Int            @default(0)
  engagement Float          @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialComments SocialComment[]
  socialLikes    SocialLike[]
  socialShares   SocialShare[]
  userMentions   UserMention[]
  polls          SocialPoll[]

  @@map("social_posts")
}

model SocialComment {
  id           String   @id @default(cuid())
  postId       String
  userId       String
  parentId     String? // For nested comments
  content      String
  mediaUrl     String?
  likes        Int      @default(0)
  repliesCount Int      @default(0)
  isEdited     Boolean  @default(false)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  post    SocialPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  SocialComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies SocialComment[] @relation("CommentReplies")

  @@map("social_comments")
}

model SocialLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("social_likes")
}

model SocialShare {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  platform  String? // Platform where it was shared
  createdAt DateTime @default(now())

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("social_shares")
}

model UserFollow {
  id                   String   @id @default(cuid())
  followerId           String
  followingId          String
  isSubscriber         Boolean  @default(false)
  notificationsEnabled Boolean  @default(true)
  createdAt            DateTime @default(now())

  follower  User @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("user_follows")
}

model UserMention {
  id          String   @id @default(cuid())
  postId      String
  mentionerId String
  mentionedId String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  mentioner User       @relation("UserMentions", fields: [mentionerId], references: [id], onDelete: Cascade)
  mentioned User       @relation("UserMentioned", fields: [mentionedId], references: [id], onDelete: Cascade)

  @@map("user_mentions")
}

model SocialPoll {
  id            String    @id @default(cuid())
  postId        String
  question      String
  options       Json // Array of poll options with vote counts
  totalVotes    Int       @default(0)
  expiresAt     DateTime?
  allowMultiple Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  post  SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@map("social_polls")
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  userId    String
  optionIds Json // Array of selected option IDs
  createdAt DateTime @default(now())

  poll SocialPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@map("poll_votes")
}

model AIRecommendation {
  id           String             @id @default(cuid())
  userId       String
  type         RecommendationType
  contentId    String? // For content recommendations
  score        Float
  reason       String
  category     String
  tags         Json? // Array of relevant tags
  confidence   Float
  isViewed     Boolean            @default(false)
  isInteracted Boolean            @default(false)
  createdAt    DateTime           @default(now())
  expiresAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_recommendations")
}

model UserInsight {
  id          String          @id @default(cuid())
  userId      String
  category    InsightCategory
  insight     String
  confidence  Float
  actionable  Boolean         @default(false)
  suggestions Json? // Array of suggestion strings
  data        Json? // Supporting data
  isRead      Boolean         @default(false)
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_insights")
}

// V2.9 New Enums

enum NotificationType {
  SYSTEM
  SUBSCRIPTION
  MESSAGE
  CONTENT
  PAYMENT
  SECURITY
  MARKETING
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  COPYRIGHT_VIOLATION
  FRAUD
  VIOLENCE
  HATE_SPEECH
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  EMAIL_CHANGE
  SUBSCRIPTION_CREATE
  SUBSCRIPTION_CANCEL
  PAYMENT_PROCESS
  CONTENT_UPLOAD
  CONTENT_DELETE
  MESSAGE_SEND
  REPORT_CREATE
  ADMIN_ACTION
}

// V3.0 New Enums

enum StreamStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
  POLL
  ANNOUNCEMENT
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  SUBSCRIBERS
  PRIVATE
}

enum RecommendationType {
  CONTENT
  CREATOR
  FEATURE
  MONETIZATION
}

enum InsightCategory {
  ENGAGEMENT
  CONTENT_PREFERENCE
  BEHAVIOR
  MONETIZATION
}

// Enhanced Payment Models
model PaymentMethod {
  id        String    @id @default(cuid())
  userId    String
  type      String // card, bank_account, paypal, crypto, apple_pay, google_pay
  provider  String // stripe, paypal, coinbase, apple, google
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  metadata  Json?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation("UserPaymentMethods", fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model PaymentIntent {
  id                    String    @id @default(cuid())
  userId                String
  amount                Float
  currency              String
  type                  String // subscription, tip, content_purchase, commission, donation
  status                String // pending, processing, succeeded, failed, cancelled, refunded
  paymentMethodId       String?
  stripePaymentIntentId String?   @unique
  metadata              Json?
  failureReason         String?
  processedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user     User             @relation("UserPaymentIntents", fields: [userId], references: [id], onDelete: Cascade)
  disputes PaymentDispute[]

  @@map("payment_intents")
}

model PaymentSubscription {
  id                   String    @id @default(cuid())
  userId               String
  creatorId            String
  tierId               String
  stripeSubscriptionId String?   @unique
  status               String // active, cancelled, past_due, unpaid, incomplete
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  cancelledAt          DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user    User @relation("UserPaymentSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  creator User @relation("CreatorPaymentSubscriptions", fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("payment_subscriptions")
}

model PaymentDispute {
  id              String    @id @default(cuid())
  paymentIntentId String
  stripeDisputeId String?   @unique
  reason          String
  status          String
  amount          Float
  currency        String
  evidence        Json?
  dueBy           DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@map("payment_disputes")
}

model PayoutSchedule {
  id               String    @id @default(cuid())
  userId           String
  amount           Float
  currency         String
  status           String // pending, processing, paid, failed
  scheduledAt      DateTime
  processedAt      DateTime?
  stripeTransferId String?
  failureReason    String?
  createdAt        DateTime  @default(now())

  user User @relation("UserPayoutSchedules", fields: [userId], references: [id], onDelete: Cascade)

  @@map("payout_schedules")
}

// Enhanced Search Models
model SearchAnalytics {
  id             String   @id @default(cuid())
  queryId        String
  userId         String?
  query          String
  resultCount    Int
  filters        Json?
  clickedResults Json?
  timeSpent      Int? // in milliseconds
  sessionId      String?
  userAgent      String?
  location       String?
  timestamp      DateTime @default(now())

  user User? @relation("UserSearchAnalytics", fields: [userId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@index([query])
  @@map("search_analytics")
}

model SavedSearch {
  id            String   @id @default(cuid())
  userId        String
  name          String
  query         String
  filters       Json?
  notifications Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation("UserSavedSearches", fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_searches")
}

model SearchTrend {
  id        String   @id @default(cuid())
  query     String
  count     Int      @default(1)
  growth    Float    @default(0)
  category  String?
  period    String // hour, day, week, month
  timestamp DateTime @default(now())

  @@unique([query, period, timestamp])
  @@index([query])
  @@index([period])
  @@map("search_trends")
}

// Mobile App Models
model MobileDevice {
  id           String   @id @default(cuid())
  userId       String
  deviceId     String   @unique
  deviceType   String // ios, android
  deviceModel  String?
  osVersion    String?
  appVersion   String
  pushToken    String?
  isActive     Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  settings     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User            @relation("UserMobileDevices", fields: [userId], references: [id], onDelete: Cascade)
  sessions MobileSession[]

  @@map("mobile_devices")
}

model MobileSession {
  id           String    @id @default(cuid())
  userId       String
  deviceId     String
  sessionToken String    @unique
  startedAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  endedAt      DateTime?
  isActive     Boolean   @default(true)
  location     Json?
  networkType  String?
  batteryLevel Int?
  metadata     Json?

  user   User         @relation("UserMobileSessions", fields: [userId], references: [id], onDelete: Cascade)
  device MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("mobile_sessions")
}

model PushNotification {
  id          String    @id @default(cuid())
  userId      String
  deviceId    String?
  title       String
  body        String
  data        Json?
  badge       Int?
  sound       String?
  category    String?
  scheduledAt DateTime?
  sentAt      DateTime?
  delivered   Boolean   @default(false)
  opened      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user User @relation("UserPushNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_notifications")
}

// Stripe Integration Models
model StripeCustomer {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  stripeCustomerId       String   @unique
  email                  String
  name                   String?
  defaultPaymentMethodId String?
  billingAddress         Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user          User                 @relation("UserStripeCustomer", fields: [userId], references: [id], onDelete: Cascade)
  subscriptions StripeSubscription[]
  invoices      StripeInvoice[]
  payments      StripePayment[]

  @@map("stripe_customers")
}

model StripeSubscription {
  id                   String    @id @default(cuid())
  userId               String
  creatorId            String
  stripeSubscriptionId String    @unique
  stripePriceId        String
  status               String // active, canceled, incomplete, past_due, unpaid
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  cancelledAt          DateTime?
  metadata             Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user             User            @relation("UserStripeSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  creator          User            @relation("CreatorStripeSubscriptions", fields: [creatorId], references: [id], onDelete: Cascade)
  invoices         StripeInvoice[]
  StripeCustomer   StripeCustomer? @relation(fields: [stripeCustomerId], references: [id])
  stripeCustomerId String?

  @@map("stripe_subscriptions")
}

model StripeInvoice {
  id              String    @id @default(cuid())
  stripeInvoiceId String    @unique
  customerId      String
  subscriptionId  String?
  amount          Float
  currency        String
  status          String // draft, open, paid, uncollectible, void
  paidAt          DateTime?
  dueDate         DateTime?
  invoiceNumber   String
  invoiceUrl      String?
  invoicePdfUrl   String?
  blobUrl         String? // Vercel Blob URL for stored PDF
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer     StripeCustomer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription StripeSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     StripePayment[]

  @@map("stripe_invoices")
}

model StripePayment {
  id                    String   @id @default(cuid())
  stripePaymentIntentId String   @unique
  customerId            String
  amount                Float
  currency              String
  status                String // succeeded, failed, canceled, processing, requires_action
  paymentMethodId       String?
  invoiceId             String?
  description           String?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  customer StripeCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice  StripeInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@map("stripe_payments")
}

// File Storage Models
model BlobStorage {
  id           String   @id @default(cuid())
  userId       String?
  fileName     String
  originalName String
  mimeType     String
  size         Int
  blobUrl      String   @unique
  category     String // avatar, content, invoice, document, etc.
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User? @relation("UserBlobStorage", fields: [userId], references: [id], onDelete: SetNull)

  @@map("blob_storage")
}

// V3.8 Complete Integration Models

model ContentInteraction {
  id        String          @id @default(cuid())
  userId    String
  contentId String
  type      InteractionType
  createdAt DateTime        @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, type])
  @@map("content_interactions")
}

model Activity {
  id          String       @id @default(cuid())
  userId      String
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activities")
}

model CreatorApplication {
  id           String            @id @default(cuid())
  userId       String
  reason       String
  contentTypes String[]
  portfolio    String?
  socialMedia  Json?
  status       ApplicationStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("creator_applications")
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  userId    String
  contentId String
  parentId  String?
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@map("comments")
}

// New Enums for V3.8
enum InteractionType {
  LIKE
  BOOKMARK
  SHARE
  VIEW
  DOWNLOAD
}

enum ActivityType {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT
  EMAIL_VERIFIED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  PROFILE_UPDATED
  CONTENT_CREATED
  CONTENT_LIKED
  CONTENT_COMMENTED
  NEW_SUBSCRIBER
  NEW_FOLLOWER
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_CANCELLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  UNDER_REVIEW
}
