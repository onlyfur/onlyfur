generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model activities {
  id          String       @id
  userId      String
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now())
  users       users        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ai_recommendations {
  id           String             @id
  userId       String
  type         RecommendationType
  contentId    String?
  score        Float
  reason       String
  category     String
  tags         Json?
  confidence   Float
  isViewed     Boolean            @default(false)
  isInteracted Boolean            @default(false)
  createdAt    DateTime           @default(now())
  expiresAt    DateTime?
  users        users              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model api_keys {
  id          String    @id
  userId      String
  name        String
  keyHash     String    @unique
  permissions Json
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  users       users     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model audit_logs {
  id                              String      @id
  userId                          String?
  adminId                         String?
  action                          AuditAction
  resource                        String
  resourceId                      String?
  oldValues                       Json?
  newValues                       Json?
  ipAddress                       String?
  userAgent                       String?
  metadata                        Json?
  createdAt                       DateTime    @default(now())
  users_audit_logs_adminIdTousers users?      @relation("audit_logs_adminIdTousers", fields: [adminId], references: [id])
  users_audit_logs_userIdTousers  users?      @relation("audit_logs_userIdTousers", fields: [userId], references: [id])
}

model blob_storage {
  id           String   @id
  userId       String?
  fileName     String
  originalName String
  mimeType     String
  size         Int
  blobUrl      String   @unique
  category     String
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  users        users?   @relation(fields: [userId], references: [id])
}

model comments {
  id             String     @id
  text           String
  userId         String
  contentId      String
  parentId       String?
  isEdited       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  content        content    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  comments       comments?  @relation("commentsTocomments", fields: [parentId], references: [id], onDelete: Cascade)
  other_comments comments[] @relation("commentsTocomments")
  users          users      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model content {
  id                   String                 @id
  creatorId            String
  title                String
  description          String?
  type                 ContentType
  mediaUrl             String?
  mediaUrls            Json
  thumbnailUrl         String?
  isPublic             Boolean                @default(true)
  requiresSubscription Boolean                @default(false)
  privacyLevel         PrivacyLevel           @default(PUBLIC)
  status               ContentStatus          @default(PUBLISHED)
  scheduledAt          DateTime?
  tags                 Json
  category             String?
  fileSize             Int?
  fileName             String?
  mimeType             String?
  dimensions           Json?
  duration             Int?
  likesCount           Int                    @default(0)
  commentsCount        Int                    @default(0)
  viewsCount           Int                    @default(0)
  sharesCount          Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  mediaMetadata        Json?
  allowComments        Boolean                @default(true)
  allowDownload        Boolean                @default(false)
  views                Int                    @default(0)
  likes                Int                    @default(0)
  tier                 String                 @default("FREE")
  textContent          String?
  comments             comments[]
  users                users                  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  content_analytics    content_analytics[]
  content_interactions content_interactions[]
  content_reports      content_reports[]
}

model content_analytics {
  id          String   @id
  contentId   String
  date        DateTime @db.Date
  views       Int      @default(0)
  uniqueViews Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  downloads   Int      @default(0)
  watchTime   Int      @default(0)
  bounceRate  Float    @default(0)
  engagement  Float    @default(0)
  content     content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, date])
}

model content_interactions {
  id        String          @id
  userId    String
  contentId String
  type      InteractionType
  createdAt DateTime        @default(now())
  content   content         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  users     users           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, type])
}

model content_reports {
  id          String       @id
  contentId   String
  reporterId  String
  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  resolution  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  content     content      @relation(fields: [contentId], references: [id], onDelete: Cascade)
  users       users        @relation(fields: [reporterId], references: [id], onDelete: Cascade)
}

model creator_applications {
  id           String            @id
  userId       String
  reason       String
  contentTypes String[]
  portfolio    String?
  socialMedia  Json?
  status       ApplicationStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime
  users        users             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model live_streams {
  id                   String                 @id
  creatorId            String
  title                String
  description          String?
  category             String
  tags                 Json
  isPrivate            Boolean                @default(false)
  requiresSubscription Boolean                @default(false)
  status               StreamStatus           @default(SCHEDULED)
  streamKey            String                 @unique
  playbackUrl          String?
  thumbnailUrl         String?
  scheduledAt          DateTime?
  startedAt            DateTime?
  endedAt              DateTime?
  duration             Int?
  viewerCount          Int                    @default(0)
  maxViewers           Int                    @default(0)
  settings             Json
  analytics            Json
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  users                users                  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  stream_chat_messages stream_chat_messages[]
  stream_donations     stream_donations[]
}

model messages {
  id                                String      @id
  conversationId                    String
  senderId                          String
  recipientId                       String
  content                           String
  messageType                       MessageType @default(TEXT)
  mediaUrl                          String?
  isRead                            Boolean     @default(false)
  readAt                            DateTime?
  createdAt                         DateTime    @default(now())
  updatedAt                         DateTime
  users_messages_recipientIdTousers users       @relation("messages_recipientIdTousers", fields: [recipientId], references: [id], onDelete: Cascade)
  users_messages_senderIdTousers    users       @relation("messages_senderIdTousers", fields: [senderId], references: [id], onDelete: Cascade)
}

model mobile_devices {
  id              String            @id
  userId          String
  deviceId        String            @unique
  deviceType      String
  deviceModel     String?
  osVersion       String?
  appVersion      String
  pushToken       String?
  isActive        Boolean           @default(true)
  lastActiveAt    DateTime          @default(now())
  settings        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  users           users             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mobile_sessions mobile_sessions[]
}

model mobile_sessions {
  id             String         @id
  userId         String
  deviceId       String
  sessionToken   String         @unique
  startedAt      DateTime       @default(now())
  lastActiveAt   DateTime       @default(now())
  endedAt        DateTime?
  isActive       Boolean        @default(true)
  location       Json?
  networkType    String?
  batteryLevel   Int?
  metadata       Json?
  mobile_devices mobile_devices @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  users          users          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model notifications {
  id        String               @id
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean              @default(false)
  readAt    DateTime?
  priority  NotificationPriority @default(NORMAL)
  expiresAt DateTime?
  createdAt DateTime             @default(now())
  users     users                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model payment_disputes {
  id              String          @id
  paymentIntentId String
  stripeDisputeId String?         @unique
  reason          String
  status          String
  amount          Float
  currency        String
  evidence        Json?
  dueBy           DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  payment_intents payment_intents @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
}

model payment_intents {
  id                    String             @id
  userId                String
  amount                Float
  currency              String
  type                  String
  status                String
  paymentMethodId       String?
  stripePaymentIntentId String?            @unique
  metadata              Json?
  failureReason         String?
  processedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime
  payment_disputes      payment_disputes[]
  users                 users              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model payment_methods {
  id        String    @id
  userId    String
  type      String
  provider  String
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  metadata  Json?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime
  users     users     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model payment_subscriptions {
  id                                           String    @id
  userId                                       String
  creatorId                                    String
  tierId                                       String
  stripeSubscriptionId                         String?   @unique
  status                                       String
  currentPeriodStart                           DateTime
  currentPeriodEnd                             DateTime
  cancelAtPeriodEnd                            Boolean   @default(false)
  cancelledAt                                  DateTime?
  trialStart                                   DateTime?
  trialEnd                                     DateTime?
  createdAt                                    DateTime  @default(now())
  updatedAt                                    DateTime
  users_payment_subscriptions_creatorIdTousers users     @relation("payment_subscriptions_creatorIdTousers", fields: [creatorId], references: [id], onDelete: Cascade)
  users_payment_subscriptions_userIdTousers    users     @relation("payment_subscriptions_userIdTousers", fields: [userId], references: [id], onDelete: Cascade)
}

model payout_schedules {
  id               String    @id
  userId           String
  amount           Float
  currency         String
  status           String
  scheduledAt      DateTime
  processedAt      DateTime?
  stripeTransferId String?
  failureReason    String?
  createdAt        DateTime  @default(now())
  users            users     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model platform_subscription_tiers {
  id                String          @id
  name              String
  type              TierType
  level             TierLevel
  price             Float
  currency          String          @default("USD")
  billingPeriod     BillingPeriod   @default(MONTHLY)
  description       String
  features          Json
  limitations       Json
  messagingFeatures Json
  contentAccess     Json
  creatorFeatures   Json?
  isPopular         Boolean         @default(false)
  color             String
  badge             String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  subscriptions     subscriptions[]
}

model poll_votes {
  id           String       @id
  pollId       String
  userId       String
  optionIds    Json
  createdAt    DateTime     @default(now())
  social_polls social_polls @relation(fields: [pollId], references: [id], onDelete: Cascade)
  users        users        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model push_notifications {
  id          String    @id
  userId      String
  deviceId    String?
  title       String
  body        String
  data        Json?
  badge       Int?
  sound       String?
  category    String?
  scheduledAt DateTime?
  sentAt      DateTime?
  delivered   Boolean   @default(false)
  opened      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  users       users     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model saved_searches {
  id            String   @id
  userId        String
  name          String
  query         String
  filters       Json?
  notifications Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  users         users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model search_analytics {
  id             String   @id
  queryId        String
  userId         String?
  query          String
  resultCount    Int
  filters        Json?
  clickedResults Json?
  timeSpent      Int?
  sessionId      String?
  userAgent      String?
  location       String?
  timestamp      DateTime @default(now())
  users          users?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@index([query])
}

model search_trends {
  id        String   @id
  query     String
  count     Int      @default(1)
  growth    Float    @default(0)
  category  String?
  period    String
  timestamp DateTime @default(now())

  @@unique([query, period, timestamp])
  @@index([period])
  @@index([query])
}

model social_comments {
  id                    String            @id
  postId                String
  userId                String
  parentId              String?
  content               String
  mediaUrl              String?
  likes                 Int               @default(0)
  repliesCount          Int               @default(0)
  isEdited              Boolean           @default(false)
  isDeleted             Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime
  social_comments       social_comments?  @relation("social_commentsTosocial_comments", fields: [parentId], references: [id])
  other_social_comments social_comments[] @relation("social_commentsTosocial_comments")
  social_posts          social_posts      @relation(fields: [postId], references: [id], onDelete: Cascade)
  users                 users             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model social_likes {
  id           String       @id
  postId       String
  userId       String
  createdAt    DateTime     @default(now())
  social_posts social_posts @relation(fields: [postId], references: [id], onDelete: Cascade)
  users        users        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model social_polls {
  id            String       @id
  postId        String
  question      String
  options       Json
  totalVotes    Int          @default(0)
  expiresAt     DateTime?
  allowMultiple Boolean      @default(false)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  poll_votes    poll_votes[]
  social_posts  social_posts @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model social_posts {
  id              String            @id
  userId          String
  content         String
  mediaUrls       Json?
  type            PostType          @default(TEXT)
  visibility      PostVisibility    @default(PUBLIC)
  isNSFW          Boolean           @default(false)
  tags            Json?
  mentions        Json?
  likes           Int               @default(0)
  comments        Int               @default(0)
  shares          Int               @default(0)
  views           Int               @default(0)
  engagement      Float             @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  social_comments social_comments[]
  social_likes    social_likes[]
  social_polls    social_polls[]
  users           users             @relation(fields: [userId], references: [id], onDelete: Cascade)
  social_shares   social_shares[]
  user_mentions   user_mentions[]
}

model social_shares {
  id           String       @id
  postId       String
  userId       String
  platform     String?
  createdAt    DateTime     @default(now())
  social_posts social_posts @relation(fields: [postId], references: [id], onDelete: Cascade)
  users        users        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model stream_chat_messages {
  id           String       @id
  streamId     String
  userId       String
  username     String
  message      String
  timestamp    DateTime     @default(now())
  isDeleted    Boolean      @default(false)
  isModerator  Boolean      @default(false)
  isCreator    Boolean      @default(false)
  metadata     Json?
  live_streams live_streams @relation(fields: [streamId], references: [id], onDelete: Cascade)
  users        users        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model stream_donations {
  id           String       @id
  streamId     String
  userId       String
  username     String
  amount       Float
  currency     String       @default("USD")
  message      String?
  timestamp    DateTime     @default(now())
  isAnonymous  Boolean      @default(false)
  live_streams live_streams @relation(fields: [streamId], references: [id], onDelete: Cascade)
  users        users        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model stripe_customers {
  id                     String                 @id
  userId                 String                 @unique
  stripeCustomerId       String                 @unique
  email                  String
  name                   String?
  defaultPaymentMethodId String?
  billingAddress         Json?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime
  users                  users                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripe_invoices        stripe_invoices[]
  stripe_payments        stripe_payments[]
  stripe_subscriptions   stripe_subscriptions[]
}

model stripe_invoices {
  id                   String                @id
  stripeInvoiceId      String                @unique
  customerId           String
  subscriptionId       String?
  amount               Float
  currency             String
  status               String
  paidAt               DateTime?
  dueDate              DateTime?
  invoiceNumber        String
  invoiceUrl           String?
  invoicePdfUrl        String?
  blobUrl              String?
  metadata             Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  stripe_customers     stripe_customers      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stripe_subscriptions stripe_subscriptions? @relation(fields: [subscriptionId], references: [id])
  stripe_payments      stripe_payments[]
}

model stripe_payments {
  id                    String           @id
  stripePaymentIntentId String           @unique
  customerId            String
  amount                Float
  currency              String
  status                String
  paymentMethodId       String?
  invoiceId             String?
  description           String?
  metadata              Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime
  stripe_customers      stripe_customers @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stripe_invoices       stripe_invoices? @relation(fields: [invoiceId], references: [id])
}

model stripe_subscriptions {
  id                                          String            @id
  userId                                      String
  creatorId                                   String
  stripeSubscriptionId                        String            @unique
  stripePriceId                               String
  status                                      String
  currentPeriodStart                          DateTime
  currentPeriodEnd                            DateTime
  trialStart                                  DateTime?
  trialEnd                                    DateTime?
  cancelAtPeriodEnd                           Boolean           @default(false)
  cancelledAt                                 DateTime?
  metadata                                    Json?
  createdAt                                   DateTime          @default(now())
  updatedAt                                   DateTime
  stripeCustomerId                            String?
  stripe_invoices                             stripe_invoices[]
  users_stripe_subscriptions_creatorIdTousers users             @relation("stripe_subscriptions_creatorIdTousers", fields: [creatorId], references: [id], onDelete: Cascade)
  stripe_customers                            stripe_customers? @relation(fields: [stripeCustomerId], references: [id])
  users_stripe_subscriptions_userIdTousers    users             @relation("stripe_subscriptions_userIdTousers", fields: [userId], references: [id], onDelete: Cascade)
}

model subscriptions {
  id                          String                      @id
  userId                      String
  tierId                      String
  status                      SubscriptionStatus          @default(ACTIVE)
  currentPeriodStart          DateTime
  currentPeriodEnd            DateTime
  cancelAtPeriodEnd           Boolean                     @default(false)
  canceledAt                  DateTime?
  trialStart                  DateTime?
  trialEnd                    DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime
  platform_subscription_tiers platform_subscription_tiers @relation(fields: [tierId], references: [id])
  users                       users                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions                transactions[]
}

model system_settings {
  id          String   @id
  category    String
  key         String   @unique
  value       String
  dataType    String   @default("string")
  description String?
  isPublic    Boolean  @default(false)
  isEditable  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@unique([category, key])
}

model transactions {
  id                String            @id
  userId            String
  subscriptionId    String?
  amount            Float
  currency          String            @default("USD")
  type              TransactionType
  status            TransactionStatus @default(PENDING)
  paymentMethodType PaymentMethodType
  paymentIntentId   String?
  description       String
  fees              Float             @default(0)
  netAmount         Float
  processedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  subscriptions     subscriptions?    @relation(fields: [subscriptionId], references: [id])
  users             users             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model two_factor_secrets {
  id          String   @id
  userId      String   @unique
  secret      String
  backupCodes Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  users       users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model user_analytics {
  id                   String   @id
  userId               String
  date                 DateTime @db.Date
  sessionTime          Int      @default(0)
  pageViews            Int      @default(0)
  contentViewed        Int      @default(0)
  messagesExchanged    Int      @default(0)
  subscriptionsChanged Int      @default(0)
  users                users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model user_follows {
  id                                    String   @id
  followerId                            String
  followingId                           String
  isSubscriber                          Boolean  @default(false)
  notificationsEnabled                  Boolean  @default(true)
  createdAt                             DateTime @default(now())
  users_user_follows_followerIdTousers  users    @relation("user_follows_followerIdTousers", fields: [followerId], references: [id], onDelete: Cascade)
  users_user_follows_followingIdTousers users    @relation("user_follows_followingIdTousers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model user_insights {
  id          String          @id
  userId      String
  category    InsightCategory
  insight     String
  confidence  Float
  actionable  Boolean         @default(false)
  suggestions Json?
  data        Json?
  isRead      Boolean         @default(false)
  createdAt   DateTime        @default(now())
  users       users           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model user_mentions {
  id                                     String       @id
  postId                                 String
  mentionerId                            String
  mentionedId                            String
  isRead                                 Boolean      @default(false)
  createdAt                              DateTime     @default(now())
  users_user_mentions_mentionedIdTousers users        @relation("user_mentions_mentionedIdTousers", fields: [mentionedId], references: [id], onDelete: Cascade)
  users_user_mentions_mentionerIdTousers users        @relation("user_mentions_mentionerIdTousers", fields: [mentionerId], references: [id], onDelete: Cascade)
  social_posts                           social_posts @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model user_preferences {
  id        String   @id
  userId    String
  category  String
  key       String
  value     String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, key])
}

model user_sessions {
  id           String   @id
  userId       String
  sessionToken String   @unique
  refreshToken String?  @unique
  ipAddress    String?
  userAgent    String?
  location     String?
  device       String?
  isActive     Boolean  @default(true)
  lastActivity DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model users {
  id                                                           String                  @id
  email                                                        String                  @unique
  username                                                     String                  @unique
