# OnlyFur Platform Production Environment Variables
# This file contains the production configuration

# Database Configuration
DATABASE_URL="your-production-postgresql-database-url"

# JWT Configuration
JWT_SECRET="your-production-jwt-secret-key-must-be-at-least-32-characters-long"
JWT_REFRESH_SECRET="your-production-jwt-refresh-secret-key-must-be-at-least-32-characters-long"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your-production-google-client-id"
GOOGLE_CLIENT_SECRET="your-production-google-client-secret"
GOOGLE_REDIRECT_URI="https://onlyfur.net/auth/callback/google"

# Frontend Google OAuth (for Vite)
VITE_GOOGLE_CLIENT_ID="your-production-google-client-id"

# API Configuration - Use relative path since frontend and backend are same domain
VITE_API_BASE_URL="/api"

# Server Configuration
NODE_ENV="production"
PORT="3000"
CLIENT_BASE_URL="https://onlyfur.net"
FRONTEND_URL="https://onlyfur.net"
CORS_ORIGIN="https://onlyfur.net"

# Admin Account
ADMIN_EMAIL="admin@onlyfur.net"
ADMIN_PASSWORD="your-secure-admin-password"
ADMIN_USERNAME="admin"

# Stripe Configuration (if using Stripe)
STRIPE_PUBLIC_KEY="your-stripe-public-key"
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

# PayPal Configuration (if using PayPal)
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
