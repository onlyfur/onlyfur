# OnlyFur Platform Environment Variables
# Copy this file to .env.local for development

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/onlyfur"

# JWT Configuration
JWT_SECRET="your-jwt-secret-key-must-be-at-least-32-characters-long"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-must-be-at-least-32-characters-long"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Google OAuth Configuration (REQUIRED for Google Sign-In)
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/callback/google"

# Frontend Google OAuth (for Vite)
VITE_GOOGLE_CLIENT_ID="your-google-client-id-here"

# Server Configuration
NODE_ENV="development"
PORT="3001"
CLIENT_BASE_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173"

# Admin Account
ADMIN_EMAIL="admin@onlyfur.net"
ADMIN_PASSWORD="your-secure-admin-password"
ADMIN_USERNAME="admin"

# Optional Services
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email Configuration (Optional)
SENDGRID_API_KEY=""
FROM_EMAIL="noreply@onlyfur.net"
FROM_NAME="OnlyFur Platform"

# Security
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Platform Settings
PLATFORM_NAME="OnlyFur"
PLATFORM_COMMISSION_RATE="0.10"
MINIMUM_PAYOUT_AMOUNT="50.00"
