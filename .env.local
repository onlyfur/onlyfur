# Development Environment Configuration
NODE_ENV=development

# Authentication
JWT_SECRET=onlyfur-super-secret-key-for-development-only
NEXTAUTH_SECRET=development-nextauth-secret
NEXTAUTH_URL=http://localhost:5173

# Admin Credentials (Development - Change in Production!)
VITE_ADMIN_EMAIL=admin@onlyfur.com
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=admin123
VITE_ADMIN_DISPLAY_NAME=OnlyFur Admin

# Backend Admin Configuration (for server authentication)
ADMIN_EMAIL=admin@onlyfur.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Google OAuth Configuration (UPDATE THESE IN PRODUCTION)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# API Configuration
VITE_API_URL=http://localhost:3001

# PostgreSQL Database (for development)
DATABASE_URL="postgresql://postgres:password@localhost:5432/onlyfur_db?schema=public"
MONGODB_URI=mock://localhost

# Mock Email Service (for development)
EMAIL_SERVER_HOST=mock
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=dev@onlyfur.com
EMAIL_SERVER_PASSWORD=mock-password
EMAIL_FROM=noreply@onlyfur.dev

# Mock Payment Processing (for development)
STRIPE_PUBLIC_KEY=pk_test_development_key
STRIPE_SECRET_KEY=sk_test_development_key
STRIPE_WEBHOOK_SECRET=whsec_development_webhook
PAYPAL_CLIENT_ID=development_paypal_client
PAYPAL_CLIENT_SECRET=development_paypal_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_development_key
NEXT_PUBLIC_PAYPAL_CLIENT_ID=development_paypal_client

# Mock File Storage (for development)
CLOUDINARY_CLOUD_NAME=development_cloud
CLOUDINARY_API_KEY=development_api_key
CLOUDINARY_API_SECRET=development_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=development_cloud

# Vercel Blob Storage (development)
BLOB_READ_WRITE_TOKEN=development_blob_token

# Platform Configuration
PLATFORM_NAME=OnlyFur
SUPPORT_EMAIL=support@onlyfur.dev

# Mobile & PWA Configuration
NEXT_PUBLIC_PWA_ENABLED=true
NEXT_PUBLIC_MOBILE_OPTIMIZED=true

# Development Settings
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true
RATE_LIMIT_MAX=1000

# Admin Credentials (CHANGE THESE IN PRODUCTION)
ADMIN_EMAIL=admin@onlyfur.dev
ADMIN_PASSWORD=admin123
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=OnlyFur Admin
