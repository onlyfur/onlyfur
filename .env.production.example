# Production Environment Variables for Vercel
# Copy these to your Vercel Environment Variables dashboard

# CRITICAL: Google OAuth (REQUIRED FOR LOGIN)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Production Settings
NODE_ENV=production
VITE_API_URL=https://your-vercel-domain.vercel.app/api

# Authentication
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars
NEXTAUTH_SECRET=your-nextauth-secret-32-chars
NEXTAUTH_URL=https://your-vercel-domain.vercel.app

# Payment Processing
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_public_key

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id

# File Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Email Service
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_email@gmail.com
EMAIL_SERVER_PASSWORD=your_app_password
EMAIL_FROM=noreply@your-domain.com

# Platform Configuration
PLATFORM_NAME=OnlyFur
SUPPORT_EMAIL=support@your-domain.com

# Mobile & PWA
NEXT_PUBLIC_PWA_ENABLED=true
NEXT_PUBLIC_MOBILE_OPTIMIZED=true

# Security
CORS_ORIGIN=https://your-vercel-domain.vercel.app
CORS_CREDENTIALS=true
RATE_LIMIT_MAX=100
BCRYPT_ROUNDS=12

# Your Neon PostgreSQL variables are already configured in Vercel
# DATABASE_URL=your_neon_database_url
# POSTGRES_PRISMA_URL=your_neon_prisma_url
# POSTGRES_URL_NON_POOLING=your_neon_non_pooling_url

# Your Vercel Blob storage is already configured
# BLOB_READ_WRITE_TOKEN=your_blob_token
